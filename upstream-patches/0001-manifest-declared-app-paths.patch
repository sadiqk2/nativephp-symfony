+
+/**
+ * The app's framework-specific entry points and paths.
+ *
+ * Every value here was previously a hardcoded Laravel string literal, which meant the
+ * runtime could only host a Laravel application. Reading them from a manifest keeps
+ * Laravel working byte-identically — the defaults below are exactly the old values —
+ * while letting another framework declare its own.
+ *
+ * A manifest lives at `nativephp.json` in the app root. The `extra.nativephp.manifest`
+ * convention is already used by nativephp/mobile-ui, so this follows it rather than
+ * inventing a second mechanism.
+ */
+interface AppManifest {
+    /** CLI entry point, relative to the app root. */
+    cli: string;
+    /** Router script for `php -S`, relative to the app root. */
+    router: string;
+    /** Document root for the dev server, relative to the app root. */
+    docroot: string;
+    /** Environment names passed as APP_ENV in development and production. */
+    env: { dev: string; prod: string };
+    /**
+     * Optional lifecycle commands. A null or absent entry is skipped — not every
+     * framework has an equivalent, and a missing one must not be fatal.
+     */
+    lifecycle: {
+        optimize?: string[] | null;
+        migrate?: string[] | null;
+        schedule?: string[] | null;
+    };
+    /**
+     * Directories to create under userData before the app boots, relative to it.
+     * These are the paths the framework expects to be writable at runtime.
+     */
+    writableDirs: string[];
+    /**
+     * Directory copied from the app into userData on first run. Null for a framework
+     * that ships no seed data.
+     */
+    seedDir: string | null;
+    /** Cache-path environment variables set for a secure build, relative to userData. */
+    cacheEnv: Record<string, string>;
+}
+
+const laravelManifest: AppManifest = {
+    cli: 'artisan',
+    router: 'vendor/laravel/framework/src/Illuminate/Foundation/resources/server.php',
+    docroot: 'public',
+    env: { dev: 'local', prod: 'production' },
+    lifecycle: {
+        optimize: ['optimize'],
+        migrate: ['migrate', '--force'],
+        schedule: ['schedule:run'],
+    },
+    // Relative to userData — these are the directories the code below actually creates,
+    // which is not the same as the app-relative paths it copies from.
+    writableDirs: [
+        'storage/logs',
+        'storage/framework/cache',
+        'storage/framework/sessions',
+        'storage/framework/views',
+        'storage/framework/testing',
+        'bootstrap/cache',
+    ],
+    seedDir: 'storage',
+    cacheEnv: {
+        APP_SERVICES_CACHE: 'services.php',
+        APP_PACKAGES_CACHE: 'packages.php',
+        APP_CONFIG_CACHE: 'config.php',
+        APP_ROUTES_CACHE: 'routes-v7.php',
+        APP_EVENTS_CACHE: 'events.php',
+    },
+};
+
+let cachedManifest: AppManifest | null = null;
+
+function getManifest(): AppManifest {
+    if (cachedManifest) {
+        return cachedManifest;
+    }
+
+    const manifestPath = join(getAppPath(), 'nativephp.json');
+
+    if (!existsSync(manifestPath)) {
+        // No manifest: a Laravel app, unchanged.
+        return (cachedManifest = laravelManifest);
+    }
+
+    let declared: Partial<AppManifest>;
+
+    try {
+        declared = JSON.parse(readFileSync(manifestPath, 'utf8'));
+    } catch (e) {
+        // A malformed manifest must not silently fall back to Laravel's paths — the app
+        // would boot into the wrong router and 404 every route with no clue why.
+        console.error(`Could not parse ${manifestPath}:`, e);
+        throw e;
+    }
+
+    // Shallow, top-level merge only. A declared key is authoritative, so `"seedDir": null`
+    // and `"cacheEnv": {}` mean *none* rather than "inherit Laravel's". Merging the nested
+    // objects would make "none" inexpressible for exactly the keys a non-Laravel app most
+    // needs to switch off.
+    cachedManifest = { ...laravelManifest, ...declared };
+
+    return cachedManifest;
+}
 
