{
    "name": "native-symfony/desktop-bundle",
    "description": "Build desktop applications with Symfony and PHP, on the NativePHP Electron runtime",
    "keywords": [
        "symfony",
        "desktop",
        "electron",
        "nativephp",
        "bundle"
    ],
    "license": "MIT",
    "type": "symfony-bundle",
    "homepage": "https://github.com/sadiqk2/nativephp-symfony",
    "authors": [
        {
            "name": "Sadiq Ali Khan",
            "homepage": "https://github.com/sadiqk2",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/sadiqk2/nativephp-symfony/issues",
        "source": "https://github.com/sadiqk2/nativephp-symfony/tree/main/bundle",
        "docs": "https://github.com/sadiqk2/nativephp-symfony/blob/main/docs/README.md"
    },
    "require": {
        "php": "^8.3",
        "psr/log": "^2.0|^3.0",
        "symfony/config": "^7.0|^8.0",
        "symfony/console": "^7.0|^8.0",
        "symfony/dependency-injection": "^7.0|^8.0",
        "symfony/event-dispatcher": "^7.0|^8.0",
        "symfony/event-dispatcher-contracts": "^2.5|^3",
        "symfony/filesystem": "^7.0|^8.0",
        "symfony/http-client": "^7.0|^8.0",
        "symfony/http-client-contracts": "^3.7",
        "symfony/http-foundation": "^7.0|^8.0",
        "symfony/http-kernel": "^7.0|^8.0",
        "symfony/process": "^7.0|^8.0",
        "symfony/routing": "^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5|^12.0",
        "symfony/framework-bundle": "^7.0|^8.0",
        "symfony/security-http": "^7.0|^8.0"
    },
    "suggest": {
        "phpunit/phpunit": "To use the testing kit in src/Testing (FakeRuntime, RuntimeExpectations)",
        "symfony/monolog-bundle": "To forward application logs into the runtime's devtools console",
        "symfony/twig-bundle": "To render the application's UI",
        "symfony/security-bundle": "To keep your own access_control off the runtime endpoints automatically (exempt_runtime_firewall)"
    },
    "autoload": {
        "psr-4": {
            "Native\\Symfony\\Desktop\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Native\\Symfony\\Desktop\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
